{
  "manifest_version": 3,
  "name": "IPTV Test Play",
  "version": "1.1.0",
  "description": "One-click stream player for IPTV channels. Auto-detects M3U8/HLS/FLV URLs and opens them in a built-in player. Designed for IPTV-Search.com, works anywhere.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "clipboardRead",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://iptv-search.com/*",
    "http://127.0.0.1:8787/*",
    "http://127.0.0.1:8788/*",
    "http://localhost:8787/*",
    "http://localhost:8788/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://iptv-search.com/*",
        "http://127.0.0.1:8787/*",
        "http://127.0.0.1:8788/*",
        "http://localhost:8787/*",
        "http://localhost:8788/*"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://iptv-search.com/*",
        "http://127.0.0.1:8787/*",
        "http://127.0.0.1:8788/*",
        "http://localhost:8787/*",
        "http://localhost:8788/*"
      ],
      "js": [
        "js/content-iptv.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "IPTV Test Play",
    "default_icon": "icons/toolbar128.png"
  },
  "icons": {
    "16": "icons/toolbar16.png",
    "48": "icons/toolbar48.png",
    "128": "icons/toolbar128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.js",
        "js/player.js",
        "pages/player.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}