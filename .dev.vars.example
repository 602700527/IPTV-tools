# 本地开发用的敏感变量样例文件
# 复制为 .dev.vars 后填入真实值（.dev.vars 已在 .gitignore 中）
# Cloudflare Workers 本地开发约定：https://developers.cloudflare.com/workers/configuration/secrets/local-development

# =====================================================
# 必填（管理员后台登录）
# =====================================================
ADMIN_KEY=your-local-dev-admin-key

# =====================================================
# 必填（邮件发送 — 注册验证、订阅通知）
# =====================================================
RESEND_API_KEY=re_local_dev_placeholder

# =====================================================
# 必填（Google OAuth 登录 — 留空则禁用 Google 登录按钮）
# =====================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =====================================================
# 必填（虎皮椒支付 — 留空则禁用微信支付渠道）
# =====================================================
XUNHUPAY_ALIPAY_APP_ID=
XUNHUPAY_ALIPAY_APP_SECRET=