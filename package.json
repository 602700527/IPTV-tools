{
  "name": "cf-tv-service",
  "version": "1.0.0",
  "type": "module",
  "description": "基于 Cloudflare Workers 的电视直播服务",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild worker.js --bundle --outfile=dist/worker.js --platform=node --target=node20 --format=esm",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "init-db": "wrangler d1 execute tv-service-db --file=./schema.sql",
    "db:console": "wrangler d1 execute tv-service-db --command"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "wrangler": "^4.116.0"
  },
  "dependencies": {
    "itty-router": "^2.6.5",
    "node-fetch": "^3.3.2"
  }
}
