{
  "name": "cf-tv-service",
  "version": "1.0.0",
  "description": "基于 Cloudflare Workers 的电视直播服务",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler publish",
    "tail": "wrangler tail",
    "init-db": "wrangler d1 execute tv-service-db --file=./schema.sql",
    "db:console": "wrangler d1 execute tv-service-db --command"
  },
  "devDependencies": {
    "better-sqlite3": "^12.5.0",
    "wrangler": "^2.20.0"
  },
  "dependencies": {
    "itty-router": "^2.6.5",
    "node-fetch": "^3.3.2"
  }
}
